{
  "name": "dsh-plugin-kimi-web-search",
  "version": "0.2.1",
  "private": true,
  "description": "Independent Kimi Code web search and fetch tools for DSH, with a compatible search provider",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./provider": "./src/provider.js",
    "./kimi-client": "./src/client.js",
    "./tools": "./src/tools.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src/",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "docs/",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check index.js && node --check src/client.js && node --check src/provider.js && node --check src/tools.js && node --test test/*.test.js",
    "live": "node test/live-search.mjs",
    "live:fetch": "node test/live-fetch.mjs"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-web": "^0.2.2-rc.1"
  }
}
