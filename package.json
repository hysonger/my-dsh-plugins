{
  "name": "my-dsh-plugins",
  "version": "0.1.0",
  "private": true,
  "description": "Personal DeepSeek Harness (DSH) plugin bundle installing all self-maintained plugins together with supply-chain-pinned third-party plugins",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hysonger/my-dsh-plugins.git"
  },
  "license": "MIT",
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": [
        "./dsh-plugin-usage-board/cordis.patch.yml",
        "./dsh-plugin-kimi-web-search/cordis.patch.yml",
        "./dsh-plugin-open-here/cordis.patch.yml",
        "./dsh-plugin-mermaid/cordis.patch.yml",
        "./dsh-plugin-sleep-control/cordis.patch.yml",
        "./dsh-plugin-opencode-go-session/cordis.patch.yml",
        "./dsh-plugin-git-log/cordis.patch.yml",
        "./dsh-plugin-subagent-model/cordis.patch.yml",
        "./cordis.patch.yml"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5",
    "@dingyi222666/dsh-session-notification": "0.2.6",
    "chinese-days": "1.5.9",
    "dsh-codex-connect": "0.2.0-alpha.15",
    "dsh-plugin-git-log": "file:./dsh-plugin-git-log",
    "dsh-plugin-kimi-web-search": "file:./dsh-plugin-kimi-web-search",
    "dsh-plugin-mermaid": "file:./dsh-plugin-mermaid",
    "dsh-plugin-open-here": "file:./dsh-plugin-open-here",
    "dsh-plugin-opencode-go-session": "file:./dsh-plugin-opencode-go-session",
    "dsh-plugin-sleep-control": "file:./dsh-plugin-sleep-control",
    "dsh-plugin-subagent-model": "file:./dsh-plugin-subagent-model",
    "dsh-plugin-usage-board": "file:./dsh-plugin-usage-board"
  },
  "scripts": {
    "test": "node --test test/",
    "check": "node --test test/"
  }
}
