{
  "name": "dsh-plugin-open-here",
  "version": "0.1.0",
  "private": true,
  "description": "Open a directory as a DSH workspace from the terminal: dsh-open [dir] switches the running App (or web) GUI to that workspace",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "bin/",
    "macos/",
    "README.md"
  ],
  "bin": {
    "dsh-open": "./bin/dsh-open"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/"
  },
  "license": "MIT"
}
