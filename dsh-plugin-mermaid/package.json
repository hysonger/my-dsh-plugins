{
  "name": "dsh-plugin-mermaid",
  "version": "0.2.0",
  "private": true,
  "description": "Render settled Mermaid fences as diagrams in the DeepSeek Harness chat, with source and copy access",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/",
    "src/",
    "scripts/",
    "test/",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "check": "node scripts/build-client.mjs --check && node --test test/",
    "test": "node --test test/"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "mdast-util-from-markdown": "2.1.0",
    "mermaid": "11.16.0"
  },
  "license": "MIT"
}
